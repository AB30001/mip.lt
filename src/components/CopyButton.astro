---
interface Props {
  value: string;
  label: string;
  copiedLabel: string;
}

const { value, label, copiedLabel } = Astro.props;
---

<button
  type="button"
  data-copy-value={value}
  data-copied-label={copiedLabel}
  class="rounded-full border border-emerald-500/40 px-4 py-1.5 text-sm text-emerald-300 transition hover:bg-emerald-500/10"
>
  {label}
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach((button) => {
    button.addEventListener('click', () => {
      navigator.clipboard
        .writeText(button.dataset.copyValue ?? '')
        .then(() => {
          const original = button.textContent;
          button.textContent = button.dataset.copiedLabel ?? original;
          setTimeout(() => (button.textContent = original), 1500);
        })
        .catch(() => {});
    });
  });
</script>
