---
interface Props {
  city: string;
  temperatureC: number;
  label: string;
}

const { city, temperatureC, label } = Astro.props;
---

<section class="flex items-center gap-4 rounded-2xl border border-slate-800 bg-slate-900/60 px-6 py-4">
  <div class="text-left">
    <p class="font-semibold text-slate-100">{city}</p>
    <p class="text-sm text-slate-400">{label}</p>
  </div>
  <p class="text-3xl font-bold text-emerald-400">{Math.round(temperatureC)}°C</p>
</section>
