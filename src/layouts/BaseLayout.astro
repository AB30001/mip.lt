---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'lt' | 'en';
}

const { title, description, lang = 'lt' } = Astro.props;

const footerLinks =
  lang === 'lt'
    ? [
        { href: '/apie', label: 'Apie' },
        { href: '/kontaktai', label: 'Kontaktai' },
        { href: '/privatumo-politika', label: 'Privatumo politika' },
        { href: '/naudojimosi-taisykles', label: 'Naudojimosi taisyklės' },
      ]
    : [
        { href: '/apie', label: 'About' },
        { href: '/kontaktai', label: 'Contact' },
        { href: '/privatumo-politika', label: 'Privacy Policy' },
        { href: '/naudojimosi-taisykles', label: 'Terms of Service' },
      ];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <slot />
    <footer class="flex flex-col items-center gap-3 py-6 text-center text-xs text-slate-600">
      <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1">
        {
          footerLinks.map((link) => (
            <a href={link.href} class="hover:text-slate-400 hover:underline">
              {link.label}
            </a>
          ))
        }
      </nav>
      <p>
        Built in collaboration with <a href="https://devhuset.no" class="underline hover:text-slate-400">Devhuset</a>
      </p>
    </footer>
  </body>
</html>
