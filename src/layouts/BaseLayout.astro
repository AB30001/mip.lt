---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'lt' | 'en';
}

const { title, description, lang = 'lt' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <slot />
    <footer class="py-6 text-center text-xs text-slate-600">
      Built in collaboration with <a href="https://devhuset.no" class="underline hover:text-slate-400">Devhuset</a>
    </footer>
  </body>
</html>
