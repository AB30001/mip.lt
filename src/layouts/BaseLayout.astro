---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'lt' | 'en';
}

const { title, description, lang = 'lt' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <slot />
    <footer class="flex flex-col items-center gap-3 py-6 text-center text-xs text-slate-600">
      <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1">
        <a href="/apie" class="hover:text-slate-400 hover:underline">Apie</a>
        <a href="/kontaktai" class="hover:text-slate-400 hover:underline">Kontaktai</a>
        <a href="/privatumo-politika" class="hover:text-slate-400 hover:underline">Privatumo politika</a>
        <a href="/naudojimosi-taisykles" class="hover:text-slate-400 hover:underline">Naudojimosi taisyklės</a>
      </nav>
      <p>
        Built in collaboration with <a href="https://devhuset.no" class="underline hover:text-slate-400">Devhuset</a>
      </p>
    </footer>
  </body>
</html>
