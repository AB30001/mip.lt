---
import BaseLayout from '../layouts/BaseLayout.astro';
import IpDisplay from '../components/IpDisplay.astro';
import WeatherCard from '../components/WeatherCard.astro';
import { getClientIp, getGeoContext, isCrawler, parseCoords } from '../lib/request';
import { getWeather } from '../lib/weather';
import { getWeatherLabel } from '../lib/wmo-codes';
import { getHomepageStrings } from '../lib/homepage-i18n';

export const prerender = false;

// The page is personal to the visitor (their IP) — never let a shared or
// edge cache serve one visitor's page to another.
Astro.response.headers.set('cache-control', 'private, no-store');

const ip = getClientIp(Astro.request);
// Astro.locals.runtime.cf was removed in Astro 6 — geolocation now lives
// directly on the request.
const geo = getGeoContext(Astro.request.cf);
const coords = parseCoords(geo);
// Crawlers (Googlebot, social-preview bots) always get Lithuanian,
// regardless of where their own infrastructure is located — otherwise
// Google indexes the English branch and this never ranks for the
// Lithuanian queries it's actually meant to target.
const effectiveCountry = isCrawler(Astro.request.headers.get('user-agent')) ? 'LT' : geo.country;
const t = getHomepageStrings(effectiveCountry);

let weather: { temperatureC: number; label: string } | null = null;

if (coords) {
  const result = await getWeather(coords.lat, coords.lon);
  if (result) {
    weather = { temperatureC: result.temperatureC, label: getWeatherLabel(result.weatherCode, t.lang) };
  }
}

const canonicalUrl = new URL('/', Astro.site).toString();
const ogImageUrl = new URL('/og-image.png', Astro.site).toString();
const webApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'mip.lt',
  url: canonicalUrl,
  description: t.pageDescription,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  inLanguage: t.lang,
};
---

<BaseLayout title={t.pageTitle} description={t.pageDescription} lang={t.lang}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.pageTitle} />
    <meta property="og:description" content={t.pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={t.lang === 'lt' ? 'lt_LT' : 'en_US'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.pageTitle} />
    <meta name="twitter:description" content={t.pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(webApplicationJsonLd)} />
  </Fragment>
  <main class="flex min-h-screen flex-col items-center justify-center gap-8 px-4 py-16 text-center">
    <a
      href="/greicio-testas"
      class="rounded-full bg-emerald-500 px-8 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-400"
    >
      {t.speedTestLabel}
    </a>
    <IpDisplay ip={ip} label={t.ipLabel} notDetectedText={t.ipNotDetected} copyLabel={t.copyLabel} copiedLabel={t.copiedLabel} />
    {weather && geo.city && <WeatherCard city={geo.city} temperatureC={weather.temperatureC} label={weather.label} />}
    {
      t.showNewsLink && (
        <nav class="text-sm text-slate-500">
          <a href="/it-naujienos" class="underline hover:text-emerald-400">
            {t.newsLinkLabel}
          </a>
        </nav>
      )
    }
  </main>
</BaseLayout>
