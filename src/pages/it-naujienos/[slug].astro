---
import { getEntry, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

// Server-rendered (not build-time getStaticPaths) so the header can show
// a real per-visitor IP here too — see Header.astro.
export const prerender = false;

const { slug } = Astro.params;
const post = slug ? await getEntry('it-naujienos', slug) : undefined;

// Unknown or (somehow requested directly) draft slug — send to the blog
// index rather than a bare 404, since there's no static 404.html fallback
// available to a Response returned straight from SSR code.
if (!post || post.data.draft) {
  return Astro.redirect('/it-naujienos', 302);
}

const { Content } = await render(post);
---

<PostLayout post={post}>
  <Content />
</PostLayout>
