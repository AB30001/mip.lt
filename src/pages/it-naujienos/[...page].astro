---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

// Server-rendered (not build-time paginate()) so the header can show a
// real per-visitor IP here too — see Header.astro. Pagination math is
// done by hand below since `paginate()` only exists inside getStaticPaths.
export const prerender = false;

const PAGE_SIZE = 12;

const allPosts = (await getCollection('it-naujienos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));

const rawPage = Astro.params.page;

// `/it-naujienos/1` would be duplicate content with `/it-naujienos`, and
// anything non-numeric or out of range isn't a real page — send all of
// these back to the canonical first page rather than rendering garbage.
if (rawPage !== undefined && (!/^\d+$/.test(rawPage) || rawPage === '1')) {
  return Astro.redirect('/it-naujienos', 302);
}

const pageNumber = rawPage ? Number(rawPage) : 1;

if (pageNumber > totalPages) {
  return Astro.redirect('/it-naujienos', 302);
}

const start = (pageNumber - 1) * PAGE_SIZE;
const pagePosts = allPosts.slice(start, start + PAGE_SIZE);
const prevUrl = pageNumber > 1 ? (pageNumber === 2 ? '/it-naujienos' : `/it-naujienos/${pageNumber - 1}`) : undefined;
const nextUrl = pageNumber < totalPages ? `/it-naujienos/${pageNumber + 1}` : undefined;

const pageTitle = 'IT naujienos – mip.lt';
const pageDescription = 'Lietuviškos IT naujienos ir paaiškinimai.';
// Self-referencing canonical per paginated page — Google's current guidance
// for paginated series, rather than the deprecated rel=next/prev approach.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL('/og-image.png', Astro.site).toString();
const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: pageTitle,
  description: pageDescription,
  url: new URL('/it-naujienos', Astro.site).toString(),
  inLanguage: 'lt',
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="lt_LT" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />
  </Fragment>
  <main class="mx-auto max-w-3xl px-4 py-16">
    <Breadcrumbs items={[{ label: 'Pradžia', href: '/' }, { label: 'IT naujienos' }]} />
    <h1 class="mb-8 text-3xl font-bold">IT naujienos</h1>
    <ul class="flex flex-col gap-6">
      {
        pagePosts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))
      }
    </ul>
    <nav class="mt-12 flex justify-between text-sm">
      {prevUrl && <a href={prevUrl} class="text-emerald-400 hover:underline">← Ankstesni</a>}
      {nextUrl && <a href={nextUrl} class="text-emerald-400 hover:underline">Kiti →</a>}
    </nav>
  </main>
</BaseLayout>
