{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  // `worker-configuration.d.ts` (site root) and
  // `workers/news-agent/worker-configuration.d.ts` (agent) are both
  // generated by `wrangler types` (see package.json's cf-typegen scripts)
  // and are picked up automatically because they fall under these globs —
  // no need to list them under "types".
  "include": [
    ".astro/types.d.ts",
    "worker-configuration.d.ts",
    "src/**/*",
    "shared/**/*",
    "workers/**/*"
  ],
  "exclude": ["dist", "node_modules"]
}
