{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mip-lt-site",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Astro's Cloudflare adapter server entrypoint — built by `astro build`,
  // this is what actually runs on the Worker.
  "main": "@astrojs/cloudflare/entrypoints/server",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, Cloudflare serves the static-asset match for "/" before
    // the worker ever runs, and the homepage renders empty. Every other
    // path stays on the static-asset fast path.
    "run_worker_first": ["/"],
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }

  // Custom domain (mip.lt) is attached via the dashboard / `wrangler deploy`
  // routes, not this config — Workers Custom Domains aren't declared here.
}
