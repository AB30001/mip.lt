{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mip-lt-site",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep the workers.dev URL alive alongside the custom domain below —
  // declaring "routes" otherwise disables it by default.
  "workers_dev": true,

  // Astro's Cloudflare adapter server entrypoint — built by `astro build`,
  // this is what actually runs on the Worker.
  "main": "@astrojs/cloudflare/entrypoints/server",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, Cloudflare serves the static-asset match for "/" before
    // the worker ever runs, and the homepage renders empty. Every other
    // path stays on the static-asset fast path.
    "run_worker_first": ["/"],
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  },

  // custom_domain: true makes `wrangler deploy` provision the Workers
  // Custom Domain itself (DNS record + SSL cert) — no dashboard clicking
  // needed. Requires the mip.lt zone to already be Active in Cloudflare.
  "routes": [{ "pattern": "mip.lt", "custom_domain": true }]
}
